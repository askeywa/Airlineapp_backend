RewriteEngine On

# Make sure mod_proxy is enabled on the server (A2 supports it on most plans)
RewriteCond %{REQUEST_URI} ^/Airlineapp
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]

# Optional: direct webhook calls
RewriteCond %{REQUEST_URI} ^/webhook
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
